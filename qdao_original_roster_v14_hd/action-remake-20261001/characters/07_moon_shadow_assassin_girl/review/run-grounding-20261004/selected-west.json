  "notes": {
    "run_W_04": "v2 chosen: near left support below pelvis with flat low sole; opposite leg folded clear of contact. v1 left both boots hanging close and support too high. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_W_06": "Same first-half support extends to screen-right rear, ankle extended and forefoot low; opposite knee forward and boot raised. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_W_07": "v2 chosen: same rear support retained at toe-contact, heel raised; unintended thin ground-shadow line from v1 removed. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_W_08": "Same rear support at terminal forefoot contact; opposite swing shin unfolds toward screen-left with boot clear of ground. Different knee/ankle silhouette from07. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_W_12": "Second-half right support under pelvis, low near-flat sole; opposite boot folded high. Own frame12 upper-body phase retained. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_W_14": "Second-half support leg extends rearward screen-right; opposite knee comes ahead airborne; lifted heel and low toe. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_W_15": "Same second-half rear support continues low forefoot contact, opposite leg bent in forward swing; two daggers visible. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_W_16": "Terminal contact of same second-half rear support, slightly more pitched boot; front swing shin extends for next01 while remaining above ground. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_NW_01": "Left/near leg unfolded for initial contact; low planted boot aligns with ownNW02 floor perspective. Right boot folded airborne; both hand/knife poses retained. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_NW_06": "v2 chosen: first-half screen-left leg stays extended low; right leg folded above it. v1 swapped support to screen-right and was rejected. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_NW_07": "v2 chosen: screen-left low support preserved from corrected06; opposite boot remains to its right and high. v1 crossed the support silhouette toward screen-right and was rejected. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_NW_08": "First-half low left support retained to terminal toe-edge posture, right boot airborne and further forward in swing. No full-body shift performed. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_NW_14": "Second-half screen-right support extended low behind pelvis, toe edge flattened and heel lifted; screen-left boot folded high. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_NW_15": "Second-half screen-right support toe edge low; left boot remains airborne. Own15 torso/hands/daggers phase retained. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending.",
    "run_NW_16": "Same second-half screen-right support extended low at last toe edge, left swing boot unfolds forward but remains high. Distinct from15. Native image statically reviewed. Two hands and two curved daggers retained; no visible opaque ground/background. Playback and root review pending."
  },
